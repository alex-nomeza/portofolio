---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { introduction, practice } from '../data/home';
import { skills } from '../data/cv';
import { profile } from '../data/profile';
import { getPublishedProjects } from '../utils/projects';
import { withBase } from '../utils/paths';
import { SocialLinks } from '../components/global/SocialLinks';

const projects = await getPublishedProjects();
const webAppProjectIds = new Set(['le-zahir', 'web-digital-selection']);
const visibleProjects = projects.filter((project) => {
  const { disciplines } = project.data;

  return (
    disciplines.includes('Design de logo') ||
    disciplines.includes('Interface et expérience utilisateur') ||
    disciplines.includes('Design de produit') ||
    disciplines.includes('Création visuelle') ||
    webAppProjectIds.has(project.id)
  );
});
---

<BaseLayout
  title="Alex Rafanomezantsoa — Designer graphique et développeur web"
  description="Portfolio d’Alex Rafanomezantsoa, designer graphique et développeur web à Nosy Be, Madagascar."
  pageClass="home-page"
>
  <div class="home container">
    <div class="home-column">
      <section class="profile" aria-labelledby="home-title">
        <div class="profile-heading">
          <div class="profile-topline">
            <p class="eyebrow">{introduction.location}</p>
            <SocialLinks
              githubUrl={profile.githubUrl}
              linkedinUrl={profile.linkedinUrl}
              email={profile.email}
            />
          </div>
          <h1 id="home-title">{introduction.name}</h1>
          <p class="profile-role">{introduction.role}</p>
        </div>
        <p class="profile-intro">{introduction.bio}</p>
      </section>

      <section id="a-propos" class="text-section about" aria-labelledby="about-title">
        <h2 id="about-title">À propos</h2>
        <p>
          Une pratique entre direction visuelle et réalisation technique, du besoin réel jusqu’à une
          réalisation claire, accessible et maintenable.
        </p>
        <ul class="practice-list">
          {practice.map((item) => <li>{item}</li>)}
        </ul>
        <div class="skills-list">
          {
            skills.map((group) => (
              <div>
                <strong>{group.title}</strong>
                <span>{group.items.join(' · ')}</span>
              </div>
            ))
          }
        </div>
      </section>

      <section id="projets" class="text-section" aria-labelledby="work-title">
        <div class="section-title">
          <h2 id="work-title">Projets</h2>
          <span>{String(visibleProjects.length).padStart(2, '0')}</span>
        </div>

        <ol class="project-list">
          {
            visibleProjects.map((project, index) => (
              <li>
                <a class="project-row" href={withBase(`projets/${project.id}/`)}>
                  <span class="project-index">{String(index + 1).padStart(2, '0')}</span>
                  <span class="project-thumbnail" aria-hidden="true">
                    <Image
                      src={project.data.cover}
                      alt=""
                      widths={[160, 240]}
                      sizes="(max-width: 40rem) 4.5rem, 5rem"
                      loading="lazy"
                    />
                  </span>
                  <span class="project-info">
                    <strong>{project.data.title}</strong>
                    <span>{project.data.disciplines.slice(0, 2).join(' · ')}</span>
                  </span>
                  {project.data.year && <span class="project-year">{project.data.year}</span>}
                  <span class="project-arrow" aria-hidden="true">
                    ↗
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .home {
    padding-block: clamp(var(--space-3), 2vw, var(--space-5))
      clamp(var(--space-3), 2vw, var(--space-4));
  }

  .home-column {
    display: grid;
    width: min(100%, 46rem);
    gap: clamp(var(--space-7), 6vw, var(--space-8));
  }

  .profile {
    display: grid;
    gap: var(--space-5);
  }

  .profile-heading {
    display: grid;
    gap: var(--space-2);
  }

  .profile-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .profile-topline .eyebrow {
    white-space: nowrap;
  }

  .profile h1 {
    max-width: none;
    overflow-wrap: normal;
    font-size: clamp(1.125rem, 5.8vw, 2.75rem);
    line-height: 1;
    white-space: nowrap;
  }

  .profile-role {
    margin: 0;
    color: var(--color-text-muted);
    font-weight: var(--font-weight-medium);
  }

  .profile-intro {
    max-width: 58ch;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-body-lg);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .text-section {
    display: grid;
    gap: var(--space-5);
  }

  .section-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .text-section h2 {
    font-size: clamp(1.125rem, 1.8vw, 1.375rem);
    letter-spacing: var(--tracking-heading);
  }

  .section-title > span {
    color: var(--color-text-muted);
    font-size: var(--font-size-meta);
    font-variant-numeric: tabular-nums;
  }

  .project-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
    list-style: none;
  }

  .project-list li + li {
    border-top: 1px solid var(--color-border);
  }

  .project-row {
    display: grid;
    grid-template-columns: 2rem 5rem minmax(0, 1fr) auto 1.25rem;
    align-items: center;
    gap: var(--space-3);
    min-height: 6.5rem;
    padding-block: var(--space-3);
    color: var(--color-text);
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      padding-inline var(--duration-fast) var(--ease-out);
  }

  .project-index,
  .project-year {
    color: var(--color-text-muted);
    font-family: var(--font-meta);
    font-size: var(--font-size-meta);
    font-variant-numeric: tabular-nums;
  }

  .project-thumbnail {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-surface-hover);
  }

  .project-thumbnail :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .project-info {
    display: grid;
    grid-template-columns: minmax(10rem, 0.9fr) minmax(12rem, 1.1fr);
    align-items: baseline;
    min-width: 0;
    gap: var(--space-4);
  }

  .project-info strong {
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-medium);
  }

  .project-info > span {
    color: var(--color-text-muted);
    font-size: var(--font-size-meta);
    line-height: 1.45;
    text-transform: uppercase;
  }

  .project-arrow {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .project-row:is(:hover, :focus-visible) {
    background: var(--color-surface-hover);
    padding-inline: var(--space-2);
  }

  .project-row:is(:hover, :focus-visible) .project-thumbnail :global(img) {
    transform: scale(1.025);
  }

  .project-row:is(:hover, :focus-visible) .project-arrow {
    transform: translate(0.125rem, -0.125rem);
  }

  .project-row:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 2px;
  }

  .practice-list li {
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .skills-list {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-ui-lg);
    background: var(--color-surface);
  }

  .skills-list > div {
    display: grid;
    grid-template-columns: minmax(10rem, 0.65fr) minmax(0, 1.35fr);
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
  }

  .skills-list > div:not(:last-child) {
    border-bottom: 1px solid var(--color-border);
  }

  .skills-list strong {
    font-weight: var(--font-weight-medium);
  }

  .skills-list span {
    color: var(--color-text-muted);
  }

  .project-meta {
    padding: 0.2rem var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-ui-sm);
    background: var(--color-surface-hover);
    color: var(--color-text-muted);
    font-size: var(--font-size-meta);
    white-space: nowrap;
  }

  .about p {
    max-width: 58ch;
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .practice-list {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding-left: 1.15rem;
  }

  .practice-list li {
    padding-left: var(--space-1);
  }

  .practice-list li::marker {
    color: var(--color-border-strong);
  }

  @media (max-width: 40rem) {
    .home {
      padding-block: var(--space-3);
    }

    .home-column {
      gap: var(--space-8);
    }

    .profile h1 {
      max-width: 100%;
    }

    .profile-intro {
      font-size: var(--font-size-body);
    }

    .project-row {
      grid-template-columns: 1.5rem 4.5rem minmax(0, 1fr) auto;
      gap: var(--space-2) var(--space-3);
      min-height: 6rem;
    }

    .project-info {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }

    .project-arrow {
      display: none;
    }

    .skills-list > div {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-row,
    .project-thumbnail :global(img),
    .project-arrow {
      transition: none;
    }
  }
</style>
