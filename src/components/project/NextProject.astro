---
import { withBase } from '../../utils/paths';
import type { Project } from '../../utils/projects';

interface Props {
  previous?: Project;
  next?: Project;
}

const { previous, next } = Astro.props;
---

<nav class="project-navigation" aria-label="Navigation entre les projets">
  {
    previous && (
      <a class="project-link previous" href={withBase(`projets/${previous.id}/`)}>
        <span class="project-label">← Projet précédent</span>
        <span class="project-title">{previous.data.title}</span>
        <span class="project-meta">
          {previous.data.disciplines[0]}
          {previous.data.year && ` · ${previous.data.year}`}
        </span>
      </a>
    )
  }
  {
    next && (
      <a class="project-link next" href={withBase(`projets/${next.id}/`)}>
        <span class="project-label">Projet suivant →</span>
        <span class="project-title">{next.data.title}</span>
        <span class="project-meta">
          {next.data.disciplines[0]}
          {next.data.year && ` · ${next.data.year}`}
        </span>
      </a>
    )
  }
</nav>

<style>
  .project-navigation {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin-top: var(--section-space);
  }

  .project-link {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-ui-lg);
    background: var(--color-surface);
    text-decoration: none;
  }

  .project-link:is(:hover, :focus-visible) {
    background: var(--color-surface-hover);
    border-color: var(--color-border-strong);
  }

  .next {
    text-align: right;
  }

  .project-label {
    color: var(--color-text-muted);
    font-size: var(--font-size-meta);
  }

  .project-title {
    font-family: var(--font-display);
    font-size: var(--font-size-body-lg);
    font-weight: var(--font-weight-medium);
  }

  .project-link:is(:hover, :focus-visible) .project-title {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .project-meta {
    color: var(--color-text-muted);
    font-size: var(--font-size-meta);
  }

  @media (max-width: 40rem) {
    .project-navigation {
      grid-template-columns: 1fr;
    }
  }
</style>
