---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  layout?: 'full' | 'wide' | 'half' | 'portrait';
  loading?: 'eager' | 'lazy';
}

const { src, alt, caption, layout = 'wide', loading = 'lazy' } = Astro.props;

const sizes =
  layout === 'half' || layout === 'portrait'
    ? '(min-width: 48rem) 44vw, 100vw'
    : '(min-width: 90rem) 90rem, 100vw';
---

<figure class="figure" data-layout={layout}>
  <Image src={src} alt={alt} widths={[480, 768, 1200, 1600]} sizes={sizes} loading={loading} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin: 0;
  }

  .figure img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-ui-lg);
  }

  .figure[data-layout='portrait'] img {
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  figcaption {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    font-family: var(--font-meta);
    font-size: var(--font-size-meta);
    letter-spacing: var(--tracking-meta);
  }
</style>
