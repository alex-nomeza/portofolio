---
import { introduction } from '../../data/home';

const capabilities = ['Identité visuelle', 'Design éditorial', 'Web & interfaces', '2D & 3D'];
---

<section id="about" class="hero" aria-labelledby="home-title">
  <p class="eyebrow">{introduction.name} · {introduction.location}</p>
  <h1 id="home-title">
    <span class="title-line">Designer graphique &</span>
    <span class="title-line">développeur web</span>
  </h1>
  <div class="hero-details">
    <p class="hero-lede">
      Je conçois des identités visuelles, des mises en page et des sites web, puis je les réalise.
    </p>
    <ul class="capabilities" aria-label="Domaines de pratique">
      {capabilities.map((capability) => <li>{capability}</li>)}
    </ul>
  </div>
</section>
<style>
  .hero {
    display: grid;
    min-height: min(40rem, 72vh);
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-6) var(--space-4);
    align-content: center;
    padding-block: clamp(var(--space-7), 7vw, var(--space-9));
  }

  .hero > .eyebrow {
    grid-column: 1 / -1;
  }

  .hero h1 {
    grid-column: 1 / 9;
    max-width: 12ch;
    font-size: clamp(3.125rem, 6.75vw, 6.25rem);
    line-height: var(--line-tight);
    overflow-wrap: normal;
  }

  .title-line {
    display: block;
  }

  .hero-details {
    display: grid;
    grid-column: 9 / -1;
    gap: var(--space-4);
    align-self: end;
  }

  .hero-lede {
    max-width: 38ch;
    margin: 0;
    font-size: var(--font-size-body-lg);
    color: var(--color-text-muted);
  }

  .capabilities {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .capabilities li {
    color: var(--color-text-muted);
    font-size: var(--font-size-meta);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .capabilities li:not(:last-child)::after {
    margin-left: var(--space-3);
    color: var(--color-border-strong);
    content: '·';
  }

  .capabilities li:hover {
    color: var(--color-text);
  }

  @media (max-width: 56rem) {
    .hero h1 {
      grid-column: 1 / -1;
    }

    .hero-details {
      grid-column: 5 / -1;
    }
  }

  @media (max-width: 35rem) {
    .hero {
      min-height: auto;
    }

    .hero h1 {
      grid-column: 1 / -1;
      font-size: clamp(2.25rem, 10vw, 3rem);
    }

    .hero-details {
      grid-column: 1 / -1;
    }
  }
</style>
