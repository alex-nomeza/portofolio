---
import { Image } from 'astro:assets';
import { LinkButton } from '../components/ui/link-button';
import { withBase } from '../utils/paths';
import BaseLayout from './BaseLayout.astro';
import ProjectGallery from '../components/project/ProjectGallery.astro';
import NextProject from '../components/project/NextProject.astro';
import ZahirSlideshow from '../components/project/ZahirSlideshow.astro';
import type { Project } from '../utils/projects';
import SiteDemos from '../components/project/SiteDemos.astro';
import { Badge } from '../components/ui/badge';

interface Props {
  project: Project;
  previous?: Project;
  next?: Project;
}

const { project, previous, next } = Astro.props;
const { data } = project;

const title = (data.seo?.title ?? data.title).replace(/ — Alex Rafanomezantsoa$/, '');
const description = data.seo?.description ?? data.summary;

interface MetaItem {
  label: string;
  value: string;
}

const meta: MetaItem[] = [
  { label: 'Disciplines', value: data.disciplines.join(', ') },
  { label: 'Rôle', value: data.role.join(', ') },
];
if (data.client) meta.push({ label: 'Client', value: data.client });
if (data.technologies?.length) {
  meta.push({ label: 'Technologies', value: data.technologies.join(', ') });
}

const links = [
  data.externalUrl ? { label: 'Voir le projet', href: data.externalUrl } : null,
  data.repositoryUrl ? { label: 'Code source', href: data.repositoryUrl } : null,
].filter((link): link is { label: string; href: string } => link !== null);
---

<BaseLayout title={`${title} — Alex Rafanomezantsoa`} description={description}>
  <article class="project container">
    <LinkButton direction="left" href={withBase('#projets')} variant="outline">
      Retour aux réalisations
    </LinkButton>
    <div
      class:list={['project-opening', { 'project-opening-showcase': project.id === 'le-zahir' }]}
    >
      <header class="project-header">
        <Badge variant="secondary">{data.year ? `Projet · ${data.year}` : 'Projet'}</Badge>
        <h1 class="project-title">{data.title}</h1>
        {data.subtitle && <p class="project-subtitle">{data.subtitle}</p>}

        <dl class="project-meta">
          {
            meta.map((item) => (
              <div>
                <dt>{item.label}</dt>
                <dd>{item.value}</dd>
              </div>
            ))
          }
        </dl>

        {
          links.length > 0 && (
            <p class="project-links">
              {links.map((link, index) => (
                <LinkButton
                  variant={index === 0 ? 'default' : 'outline'}
                  direction="external"
                  href={link.href}
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  {link.label}
                </LinkButton>
              ))}
            </p>
          )
        }
      </header>

      {
        project.id !== 'le-zahir' && (
          <Image
            class="project-cover"
            src={data.cover}
            alt={data.coverAlt}
            widths={[768, 1200, 1600, 2000]}
            sizes="(min-width: 56rem) 50vw, 100vw"
            loading="eager"
          />
        )
      }
    </div>
    {project.id === 'le-zahir' && <ZahirSlideshow src={data.cover} alt={data.coverAlt} />}
    <div class="project-body editorial-reading">
      <slot />
      {project.id === 'web-digital-selection' && <SiteDemos />}
    </div>

    {data.gallery && <ProjectGallery items={data.gallery} />}

    {(previous || next) && <NextProject previous={previous} next={next} />}
    <footer class="project-footer page-actions">
      <LinkButton href={withBase('#projets')} direction="left">Retour aux réalisations</LinkButton>
      <LinkButton href={withBase()}>Accueil</LinkButton>
    </footer>
  </article>
</BaseLayout>

<style>
  .project {
    padding-block: var(--space-7) var(--section-space);
  }
  .project-opening {
    display: grid;
    gap: var(--space-7);
    margin-top: var(--space-6);
  }
  .project-header {
    display: grid;
    gap: var(--space-5);
  }
  .project-title {
    max-width: 13ch;
    font-size: var(--font-size-h1);
    line-height: var(--line-tight);
  }
  .project-subtitle {
    max-width: 58ch;
    color: var(--color-text-muted);
    margin: 0;
    font-size: var(--font-size-body-lg);
  }
  .project-meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    overflow: hidden;
    margin: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-ui-lg);
    background: var(--color-surface);
  }
  .project-meta > div {
    padding: var(--space-4);
  }
  .project-meta > div:nth-child(even) {
    border-left: 1px solid var(--color-border);
  }
  .project-meta > div:nth-child(n + 3) {
    border-top: 1px solid var(--color-border);
  }
  .project-meta dt {
    font-size: var(--font-size-meta);
    color: var(--color-text-muted);
  }
  .project-meta dd {
    margin: var(--space-2) 0 0;
    font-size: var(--font-size-nav);
  }
  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  .project-cover {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-ui-lg);
  }
  .project-body {
    margin-top: var(--section-space);
    padding-top: 0;
  }
  .project-footer {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    justify-content: space-between;
    border-top: 1px solid var(--color-border);
  }
  @media (max-width: 55.999rem) {
    .project-meta {
      grid-template-columns: 1fr;
    }
    .project-meta > div:nth-child(even) {
      border-left: 0;
    }
    .project-meta > div + div {
      border-top: 1px solid var(--color-border);
    }
  }
</style>
